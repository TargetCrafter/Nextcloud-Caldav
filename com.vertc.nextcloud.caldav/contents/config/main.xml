<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile arg="true"/>
  <group name="Account">
    <entry name="serverUrl" type="String">
      <label>Nextcloud server URL</label>
      <default></default>
    </entry>
    <entry name="username" type="String">
      <label>Username</label>
      <default></default>
    </entry>
    <entry name="appPassword" type="Password">
      <label>App password</label>
      <default></default>
    </entry>
  </group>
  <group name="Calendars">
    <!-- Parallel string lists describing every discovered calendar/task-list collection. -->
    <entry name="calendarUrls" type="StringList">
      <default></default>
    </entry>
    <entry name="calendarNames" type="StringList">
      <default></default>
    </entry>
    <entry name="calendarColors" type="StringList">
      <default></default>
    </entry>
    <!-- "VEVENT" or "VTODO", one entry per calendarUrls entry -->
    <entry name="calendarKinds" type="StringList">
      <default></default>
    </entry>
    <entry name="enabledCalendarUrls" type="StringList">
      <default></default>
    </entry>
    <!-- "ics" for a directly-subscribed external .ics feed URL (see
         ConfigGeneral.qml's "Add calendar by URL"); "caldav" (or missing,
         for calendars saved before this existed) for one discovered from
         the Nextcloud account via PROPFIND. One entry per calendarUrls
         entry - see main.qml's enabledCalendarList(). -->
    <entry name="calendarSources" type="StringList">
      <default></default>
    </entry>
    <!-- Per-calendar substring filters: one calendarUrls entry per line,
         multiple filter phrases within an entry joined by "\n" (the same
         "combine into one StringList slot" trick calendarKinds uses with
         "+"). An event/task must contain at least one (case-insensitively)
         to be shown; empty means no filtering. See main.qml's
         matchesCalendarFilters(). -->
    <entry name="calendarFilters" type="StringList">
      <default></default>
    </entry>
    <!-- Same shape as calendarFilters, but exclusion instead of inclusion:
         an event/task containing any of these (case-insensitively) is
         hidden, checked before calendarFilters so an exclude always wins
         over an include. See main.qml's matchesCalendarFilters(). -->
    <entry name="calendarExcludeFilters" type="StringList">
      <default></default>
    </entry>
  </group>
  <group name="TaskListState">
    <!-- UIDs of parent tasks whose subtasks are currently folded away.
         Pruned on every refresh to just the UIDs of tasks that still exist
         and still have subtasks - see groupRootOf/pruneCollapsedTaskUids in
         main.qml - so this doesn't grow to list every task ever collapsed. -->
    <entry name="collapsedTaskUids" type="StringList">
      <default></default>
    </entry>
    <!-- Whether the "Recently completed" section (see main.qml's
         rebuildAgendaSections) is currently open. -->
    <entry name="recentlyClosedExpanded" type="Bool">
      <default>false</default>
    </entry>
  </group>
  <group name="General">
    <entry name="displayMode" type="Enum">
      <label>What to show</label>
      <choices>
        <choice name="Combined"/>
        <choice name="EventsOnly"/>
        <choice name="TasksOnly"/>
      </choices>
      <default>Combined</default>
    </entry>
    <entry name="daysAhead" type="Int">
      <label>How many days of upcoming events to show</label>
      <default>14</default>
      <min>1</min>
      <max>90</max>
    </entry>
    <entry name="refreshInterval" type="Int">
      <label>Refresh interval in minutes</label>
      <default>15</default>
      <min>1</min>
      <max>240</max>
    </entry>
    <entry name="showTasks" type="Bool">
      <label>Show tasks (VTODO)</label>
      <default>true</default>
    </entry>
    <entry name="showCompletedTasks" type="Bool">
      <label>Show completed tasks</label>
      <default>false</default>
    </entry>
    <entry name="showOverdueTasksOnly" type="Bool">
      <label>In compact view, count overdue tasks only</label>
      <default>false</default>
    </entry>
    <entry name="notifyEventAlarms" type="Bool">
      <label>Notify for event reminders</label>
      <default>true</default>
    </entry>
    <entry name="notifyTasksDueSoon" type="Bool">
      <label>Notify when a task is due soon</label>
      <default>true</default>
    </entry>
    <entry name="taskDueSoonMinutes" type="Int">
      <label>Minutes before due to notify</label>
      <default>30</default>
      <min>1</min>
      <max>1440</max>
    </entry>
  </group>
  <group name="Appearance">
    <entry name="viewMode" type="Enum">
      <label>Agenda layout</label>
      <choices>
        <choice name="List"/>
        <choice name="Month"/>
      </choices>
      <default>List</default>
    </entry>
    <entry name="compactMode" type="Enum">
      <label>What the panel icon/label shows</label>
      <choices>
        <choice name="NextEvent"/>
        <choice name="TodayCount"/>
        <choice name="IconOnly"/>
      </choices>
      <default>NextEvent</default>
    </entry>
    <entry name="showEventLocation" type="Bool">
      <default>true</default>
    </entry>
    <entry name="use24HourClock" type="Bool">
      <default>true</default>
    </entry>
  </group>
</kcfg>
